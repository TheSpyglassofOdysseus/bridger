# Place inside an HTTPS server block. Adjust ports to match bridge.env.

location = /bridge-mcp {
    proxy_pass http://127.0.0.1:18877/mcp;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 310s;
    client_max_body_size 1m;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}

location /bridge-actions/ {
    proxy_pass http://127.0.0.1:18878/;
    proxy_http_version 1.1;
    proxy_read_timeout 310s;
    client_max_body_size 256k;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
}
