# Copy to /etc/bridger/bridger.env (or another protected path) and restrict permissions to 0640 or tighter.
# Replace every REPLACE_* placeholder before starting services.
BRIDGE_DC_PORT=18877
MCP_PROXY_API_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

# Legacy interactive machine-control credential. Treat as high authority.
BRIDGE_ACTIONS_PORT=18878
BRIDGE_ACTIONS_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_VALUE
BRIDGE_ACTIONS_PUBLIC_URL=https://bridge.example.com/bridge-actions

# Optional Passrail durable/scheduled-work layer.
BRIDGE_PASSRAIL_INGRESS_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_VALUE
BRIDGE_PASSRAIL_ALLOWED_PROJECTS=bridger-smoke,example-project
PASSRAIL_DB=/home/bridge/.local/state/passrail/passrail.sqlite3
PASSRAIL_SRC=/home/bridge/.local/lib/passrail/current

# Local Passrail -> Bridger execution boundary.
BRIDGE_DIRECT_SOCKET=/home/bridge/.local/state/bridger/direct/bridger.sock
BRIDGE_EXECUTION_GRANT_KEY_FILE=/home/bridge/.config/bridger/passrail-execution-grant.key
BRIDGE_EXECUTION_LEDGER_STATE=/home/bridge/.local/state/bridger/execution-ledger.json
BRIDGE_EXECUTION_ARTIFACT_DIR=/home/bridge/.local/state/bridger/artifacts
BRIDGE_GIT_AUTHORITY_ROOTS=/home/bridge/projects
BRIDGE_DIRECT_ONLY=1
PASSRAIL_BRIDGER_PROJECTS=bridger-smoke,example-project

# Migration-only legacy GitHub mailbox adapter. Leave unset on a direct-only deployment.
# BRIDGE_MAILBOX_REPO=owner/private-mailbox
# BRIDGE_MAILBOX_ISSUE=1
# BRIDGE_MAILBOX_TRUSTED_LOGIN=owner
# BRIDGE_MAILBOX_TRUSTED_APP=chatgpt-codex-connector
# BRIDGE_MAILBOX_STATE=/home/bridge/.local/state/bridger/mailbox-state.json
# BRIDGE_MAILBOX_POLL_SECONDS=10
# BRIDGE_MAILBOX_MAX_AGE_SECONDS=3600
